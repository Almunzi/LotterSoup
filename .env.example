# Public application URL. Do not include a trailing slash.
NEXT_PUBLIC_SITE_URL=https://lotterysoup.com

# Optional search-engine ownership verification tokens.
GOOGLE_SITE_VERIFICATION=replace_me
BING_SITE_VERIFICATION=replace_me

# Stripe server credentials. Never expose these with NEXT_PUBLIC_ prefixes.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Created by `npm run stripe:setup`.
STRIPE_PRICE_WEEKLY=price_replace_me
STRIPE_PRICE_MONTHLY=price_replace_me
STRIPE_PRICE_ANNUAL=price_replace_me
STRIPE_PORTAL_CONFIGURATION_ID=bpc_replace_me
STRIPE_CUSTOMER_PORTAL_URL=https://billing.stripe.com/p/login/replace_me

# Supabase Auth uses the public project URL and publishable key for user sessions.
NEXT_PUBLIC_SUPABASE_URL=https://replace-me.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Supabase billing administration uses the server-only sb_secret_ key.
SUPABASE_URL=https://replace-me.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Mailchimp Marketing API. Use the existing LotterySoup audience, not a new one.
# The server prefix is the API-key suffix (for example, us21).
MAILCHIMP_API_KEY=replace_me-us21
MAILCHIMP_SERVER_PREFIX=us21
MAILCHIMP_AUDIENCE_ID=replace_me

# "pending" uses Mailchimp double opt-in and is the safest default.
# Use "subscribed" only when the customer has explicitly agreed to receive the newsletter.
MAILCHIMP_NEW_MEMBER_STATUS=pending
MAILCHIMP_ARCHIVE_LIMIT=100

# Generate a long random value. Vercel sends it as the Bearer token to the cron route.
CRON_SECRET=replace_with_at_least_32_random_bytes
